# ADK Course — environment variables
# Copy to .env and fill in your keys. .env is .gitignored.

# ─── OpenRouter (Part 1 — vendor-agnostic modules M01–M10, M14) ─────────────
# Get a key at https://openrouter.ai/keys — pay-as-you-go.
# Used via LiteLLM to access Claude, GPT, Gemini, Qwen, Gemma, Llama, etc.
OPENROUTER_API_KEY=

# ─── Google AI Studio (Part 2 — Gemini unlocks M11–M13) ─────────────────────
# Get a key at https://aistudio.google.com/apikey — free tier available.
# Used for: Google Search grounding, long context + caching, thinking budgets, Live API.
GOOGLE_API_KEY=

# ADK reads this to decide whether to hit Vertex AI vs Google AI Studio.
# Keep FALSE unless you're deploying on Vertex (requires GCP billing).
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# ─── Windows only ────────────────────────────────────────────────────────────
# Prevents UnicodeDecodeError on stdout when LiteLLM / MCP emit non-ASCII tokens.
# Uncomment on Windows:
# PYTHONUTF8=1
